# Browser-visible, same-origin API path. Never put secrets in VITE_ variables.
VITE_API_BASE_URL=/api/app/v1
# Development server settings; these are not bundled into the browser.
DEV_SERVER_PORT=5173
DEV_API_PROXY_TARGET=http://127.0.0.1:3000
# Local UI preview only. Never enable for production builds.
VITE_USE_MOCK_API=false
